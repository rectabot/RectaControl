{
  "name": "rectacontrol",
  "version": "0.1.0",
  "description": "RectaControl — branded grblHAL desktop sender for the RectaBot CNC controller",
  "main": "./out/main/index.js",
  "author": "RectaBot",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "basic-ftp": "^6.0.1",
    "electron-updater": "^6.8.9",
    "serialport": "^12.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "three": "^0.169.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.rectabot.rectacontrol",
    "productName": "RectaControl",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../Firmware/variants",
        "to": "Firmware/variants",
        "filter": [
          "**/*.uf2"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rectabot",
        "repo": "RectaControl-releases"
      }
    ]
  }
}
